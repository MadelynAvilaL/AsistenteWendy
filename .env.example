# Copia este archivo como .env
# Clave GRATIS de Google Gemini: https://aistudio.google.com/apikey
# Si la dejas así, Wendy funciona igual pero solo con su base de datos.
GEMINI_API_KEY=pega_tu_clave_aqui
# Opcional: modelo de Gemini (por defecto el Flash más reciente)
# GEMINI_MODEL=gemini-flash-latest
PORT=3000
# Opcional: tu ciudad, por si el navegador no da tu ubicación (para el clima)
# WENDY_CIUDAD=Ciudad de Guatemala
# Opcional: Supabase (memoria compartida entre tu computadora y la versión en internet)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# Opcional: código para que solo quien tú quieras use tu Wendy publicada
# WENDY_CODIGO=inventa-un-codigo
